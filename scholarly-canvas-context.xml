    }
    // If logged out, maybe read-only? For now assuming locked if private
    if (!user) {
        setCanEdit(false);
        setPermissionStatus('unauthorized');
        return;
    }
    const checkPermissions = () => {
      // Admin Override
      if (user.id === 'FgH8dLkSiHbYwF78PkCHmZvP3M12') return true;
      // Owner Override - Check against Firebase UID if available, else fallback (though user wants strict mismatch fix)
      if (firebaseUid && firebaseUid === mapData.ownerId) return true;
      // Fallback to Clerk ID just in case migration hasn't happened or strictly legacy
      if (user.id === mapData.ownerId) return true;
      // List Checks
      const email = user.primaryEmailAddress?.emailAddress;
      if (mapData.editors?.includes(email)) return true;
      if (mapData.sharedWith?.includes(email)) return true; // Legacy
      return false;
    };
    const isAuthorized = checkPermissions();
