import React, { useState, useEffect } from 'react';
import { useUser } from '@clerk/clerk-react';
import { useNavigate } from 'react-router-dom';
import { Plus, BookOpen, ArrowRight } from 'lucide-react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Card, CardHeader, CardTitle, CardContent, CardFooter } from '@/components/ui/card';
import { createMap, getUserMaps } from '@/lib/db-service';
import { useFirebaseAuth } from './FirebaseAuthConfig';
export default function Dashboard() {
  const { user } = useUser();
  const { isAuthReady, isAuthLoading, firebaseUid } = useFirebaseAuth();
  const navigate = useNavigate();
  const [maps, setMaps] = useState([]);
  const [loading, setLoading] = useState(true);
  // New Map Form State
  const [isCreating, setIsCreating] = useState(false);
  const [newMapTitle, setNewMapTitle] = useState('');
  const [sourceA, setSourceA] = useState('');
  const [sourceB, setSourceB] = useState('');
  useEffect(() => {
    if (user && isAuthReady && !isAuthLoading) {
      loadMaps();
    }
  }, [user, isAuthReady, isAuthLoading]);
  if (isAuthLoading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-slate-50 text-slate-400">
        <div className="flex flex-col items-center gap-2">
          <div className="h-6 w-6 border-2 border-slate-300 border-t-slate-600 rounded-full animate-spin"></div>
          <p className="text-sm font-medium">Connecting to secure database...</p>
        </div>
      </div>
    );
  }
  const loadMaps = async () => {
    try {
      setLoading(true);
      const email = user.primaryEmailAddress?.emailAddress;
      // Use Firebase UID if available, fallback to Clerk ID
      const currentUserId = firebaseUid || user.id;
      const userMaps = await getUserMaps(currentUserId, email);
      // Sort by createdAt desc (client-side for now as we didn't add index yet)
      const sortedMaps = userMaps.sort((a, b) => {
        const dateA = a.createdAt?.toDate ? a.createdAt.toDate() : new Date(0);
        const dateB = b.createdAt?.toDate ? b.createdAt.toDate() : new Date(0);
        return dateB - dateA;
      });
      setMaps(sortedMaps);
    } catch (error) {
      console.error("Failed to load maps", error);
    } finally {
      setLoading(false);
    }
  };
  const handleCreateMap = async (e) => {
    e.preventDefault();
    if (!newMapTitle || !sourceA || !sourceB) return;
    try {
      // Use Firebase UID if available, fallback to Clerk ID
      const currentUserId = firebaseUid || user.id;
      const mapId = await createMap(currentUserId, newMapTitle, sourceA, sourceB);
      setNewMapTitle('');
      setSourceA('');
      setSourceB('');
      setIsCreating(false);
      navigate(`/map/${mapId}`);
    } catch (error) {
      console.error("Failed to create map", error);
    }
  };
  return (
    <div className="min-h-screen bg-slate-50 font-sans p-8">
      <div className="max-w-5xl mx-auto space-y-8">
        {/* Header */}
        <div className="flex justify-between items-end border-b pb-6">
          <div>
            <h1 className="text-4xl font-extrabold text-slate-900 tracking-tight">Dashboard</h1>
            <p className="text-slate-500 font-medium mt-2">Welcome back, {user?.firstName}.</p>
          </div>
          <Button onClick={() => setIsCreating(!isCreating)} className="bg-slate-900 text-white">
            <Plus className="mr-2 h-4 w-4" /> New Map
          </Button>
        </div>
        {/* Create Map Form */}
        {isCreating && (
          <Card className="bg-white border-2 border-slate-200 animate-in fade-in slide-in-from-top-4">
            <CardHeader>
              <CardTitle>Create a New Comparative Map</CardTitle>
            </CardHeader>
            <CardContent>
              <form onSubmit={handleCreateMap} className="space-y-4">
                <div className="grid gap-2">
                  <label className="text-sm font-bold text-slate-700">Map Title</label>
                  <Input 
                    placeholder="e.g. Power & Corruption" 
                    value={newMapTitle} 
                    onChange={(e) => setNewMapTitle(e.target.value)}
                  />
                </div>
                <div className="grid grid-cols-2 gap-4">
                  <div className="grid gap-2">
                    <label className="text-sm font-bold text-slate-700">Text A</label>
                    <Input 
                      placeholder="e.g. Macbeth" 
                      value={sourceA} 
                      onChange={(e) => setSourceA(e.target.value)}
                    />
                  </div>
                  <div className="grid gap-2">
                    <label className="text-sm font-bold text-slate-700">Text B</label>
                    <Input 
                      placeholder="e.g. Animal Farm" 
                      value={sourceB} 
                      onChange={(e) => setSourceB(e.target.value)}
                    />
                  </div>
                </div>
                <div className="flex justify-end gap-2 pt-2">
                  <Button type="button" variant="ghost" onClick={() => setIsCreating(false)}>Cancel</Button>
                  <Button type="submit" disabled={!newMapTitle || !sourceA || !sourceB}>Create Map</Button>
                </div>
              </form>
            </CardContent>
          </Card>
        )}
        {/* Maps Grid */}
        {loading ? (
          <div className="text-center py-20 text-slate-400">Loading maps...</div>
        ) : maps.length === 0 ? (
          <div className="text-center py-20 border-2 border-dashed border-slate-200 rounded-xl">
            <BookOpen className="h-12 w-12 text-slate-300 mx-auto mb-4" />
            <h3 className="text-lg font-bold text-slate-900">No maps yet</h3>
            <p className="text-slate-500">Create your first comparative analysis map to get started.</p>
          </div>
        ) : (
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {maps.map((map) => (
              <Card 
                key={map.id} 
                className="group cursor-pointer hover:shadow-lg transition-all border-slate-200 hover:border-slate-300"
                onClick={() => navigate(`/map/${map.id}`)}
              >
                <CardHeader>
                  <CardTitle className="flex justify-between items-start">
                    <span className="text-xl font-bold truncate pr-4">{map.title}</span>
                    <ArrowRight className="h-5 w-5 text-slate-300 group-hover:text-slate-600 transition-colors" />
                  </CardTitle>
                </CardHeader>
                <CardContent>
                  <div className="flex items-center gap-2 text-sm text-slate-500 font-medium">
                    <span className="bg-blue-50 text-blue-700 px-2 py-1 rounded border border-blue-100">{map.sourceA}</span>
                    <span className="text-slate-300">vs</span>
                    <span className="bg-orange-50 text-orange-700 px-2 py-1 rounded border border-orange-100">{map.sourceB}</span>
                  </div>
                </CardContent>
                <CardFooter className="text-xs text-slate-400 border-t pt-4 mt-2">
                  Last updated: {map.updatedAt?.toDate ? map.updatedAt.toDate().toLocaleDateString() : 'Just now'}
                </CardFooter>
              </Card>
            ))}
          </div>
        )}
      </div>
    </div>
  );
}
